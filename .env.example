DATABASE_URL=sqlite+pysqlite:///./data/interview-share-canvas.db
# PostgreSQL alternative:
# DATABASE_URL=postgresql+psycopg://interview:interview@localhost:5432/interview_share_canvas
PUBLIC_BASE_URL=http://127.0.0.1:8091

# Telemetry. Unset, the backend runs uninstrumented. See the README's
# Observability section.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Under Docker Compose the collector is reached through the host instead:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
# ENVIRONMENT_NAME=local
# IMAGE_TAG=local
